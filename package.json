{
  "name": "rsemble-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -p name -c cyan,yellow \"npm:dev:web\" \"npm:dev:bridge\"",
    "dev:web": "vite --strictPort",
    "dev:web-only": "vite --strictPort",
    "dev:bridge": "tsx server/codex-bridge/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "tsc -b",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "check": "npm run typecheck:web && npm run typecheck:server && npm run test && npm run build",
    "preview": "vite preview",
    "qa:design-motion": "node scripts/cdp-design-motion-qa.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
