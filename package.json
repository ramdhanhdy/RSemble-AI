{
  "name": "rsemble-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -p name -c cyan,yellow \"npm:dev:web\" \"npm:dev:bridge\"",
    "dev:web": "vite --strictPort",
    "dev:web-only": "vite --strictPort",
    "dev:bridge": "tsx server/codex-bridge/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "tsc -b",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck:web && npm run typecheck:server && npm run test && npm run build",
    "preview": "vite preview",
    "qa:design-motion": "node scripts/cdp-design-motion-qa.mjs",
    "qa:evaluations-identity": "node scripts/cdp-evaluations-identity-qa.mjs",
    "qa:roster-extension": "node scripts/cdp-experiment-roster-extension-qa.mjs",
    "qa:suite-reliability": "node scripts/cdp-suite-reliability-qa.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.9.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.49",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
