# OpenRouter API key (https://openrouter.ai/keys)
# VITE_OPENROUTER_KEY=sk-or-your-key-here

# Gemini AI Studio API key (https://aistudio.google.com)
# VITE_GEMINI_KEY=AIzaSy-your-key-here

# DeepSeek API key (https://platform.deepseek.com/api_keys)
# VITE_DEEPSEEK_KEY=sk-your-key-here

# Codex Local Bridge URL (default: http://127.0.0.1:8787)
# VITE_CODEX_BRIDGE_URL=http://127.0.0.1:8787

# CommandCode API key (https://commandcode.ai/docs/provider)
# VITE_COMMANDCODE_KEY=cmd-your-key-here

# ClinePass API key (https://docs.cline.bot/api/overview)
# VITE_CLINEPASS_KEY=cline-your-key-here

# Umans Code API key (https://app.umans.ai/billing → Dashboard → API Keys)
# VITE_UMANS_KEY=umans-your-key-here

# Optional 9Router API key (blank is valid when 9Router requireApiKey=false)
# VITE_9ROUTER_KEY=sk-your-local-router-key

# 9Router upstream used by the local RSemble bridge
# RSEMBLE_9ROUTER_URL=http://127.0.0.1:20128

# Optional local bridge authentication (Plan 002 D3). When set, the bridge
# requires X-RSemble-Bridge-Secret on every credential-bearing endpoint and the
# web app attaches it. Both values must match; keep the value a long random
# string. Unset = bridge authentication disabled.
# RSEMBLE_BRIDGE_SECRET=replace-with-a-long-random-string
# VITE_RSEMBLE_BRIDGE_SECRET=replace-with-a-long-random-string
